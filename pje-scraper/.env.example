# Configurações — Falaw Advogados
# Copie este arquivo para .env e preencha os valores

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=sua-service-role-key-aqui

# ── Projuris API ───────────────────────────────────────────────────────────────
# URL base — consulte a documentação do Projuris (ex: https://api.projuris.com.br/v1)
PROJURIS_API_URL=
PROJURIS_CLIENT_ID=api_cliente_codigo_122785
PROJURIS_CLIENT_SECRET=sua-client-secret-aqui

# Período de busca em dias a partir de hoje
DIAS_BUSCA=365

# ── Identificação ──────────────────────────────────────────────────────────────
ADVOGADO_NOME=TATIANA

# ── Porta do servidor local ────────────────────────────────────────────────────
PORT=7777

# ── Pauta de Audiências (Projuris ADV → Supabase) ─────────────────────────────
# URL base do serviço Projuris ADV (não altere)
PROJURIS_BASE_URL=https://service.projurisadv.com.br
# Token do Projuris ADV capturado do browser:
#   Abra o Projuris → F12 → Network → qualquer request → header Authorization: Bearer xxxxx
PROJURIS_BEARER_TOKEN=
# Período padrão da pauta em dias a partir de hoje
DIAS_PAUTA=365
