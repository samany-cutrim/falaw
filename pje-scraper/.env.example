# Configurações do PJe Scraper — Falaw Advogados
# Copie este arquivo para .env e preencha os valores

# ── Supabase ───────────────────────────────────────────────────────────────────
# Cole a mesma URL e chave anon usadas no admin (sb-config.js)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=sua-anon-key-aqui

# ── Extensão Whom ─────────────────────────────────────────────────────────────
# ID da extensão Whom instalada no Chrome de scraping (FalawScraper).
# Para encontrar: abra chrome://extensions no Chrome de scraping, ative modo
# desenvolvedor e copie o ID da extensão Whom. Ou use o link que aparece em
# chrome-extension://ESTE_ID_AQUI/sidepanel.html?mode=tab
WHOM_EXT_ID=lnidijeaekolpfeckelhkomndglcglhh
WHOM_EXT_POPUP=sidepanel.html?mode=tab

# Nome do certificado digital conforme aparece no Whom (para seleção automática)
WHOM_CERT_NAME=

# ── Porta do servidor local ────────────────────────────────────────────────────
PORT=7777
