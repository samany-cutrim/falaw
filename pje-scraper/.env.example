# Configurações do PJe Scraper — Falaw Advogados
# Copie este arquivo para .env e preencha os valores

# ── Supabase ───────────────────────────────────────────────────────────────────
# Cole a mesma URL e chave anon usadas no admin (sb-config.js)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=sua-anon-key-aqui

# ── Certificado Digital (Whom / ICPBrasil) ─────────────────────────────────────
# Se você tiver um arquivo .pfx exportado do Whom, informe o caminho completo.
# Exemplo Windows: C:\Users\Tatiana\certificado\tatiana.pfx
# Se deixar em branco, o navegador abrirá e o Whom cuidará do login manualmente.
CERT_PATH=
CERT_PASSWORD=

# ── Identificação da advogada ──────────────────────────────────────────────────
ADVOGADO_NOME=TATIANA

# ── Porta do servidor local ────────────────────────────────────────────────────
PORT=7777
