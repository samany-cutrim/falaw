generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model StoredFile {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       String
  ownerId    String
  fileName   String
  mimeType   String
  sizeBytes  Int
  data       Bytes
  createdAt  DateTime @default(now())
}

model ClientReport {
  id          String   @id
  clientId    String
  title       String
  period      String?
  description String?
  fileName    String
  fileUrl     String?
  fileSize    Int?
  uploadedAt  DateTime @default(now())
  stats       Json?

  @@index([clientId, uploadedAt])
}

model IfoodPeriod {
  id        String   @id
  label     String
  monthYear String   @map("month_year")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([monthYear])
}

model IfoodKpi {
  id         String   @id
  periodId   String   @map("period_id")
  tabKey     String   @map("tab_key")
  kpiKey     String   @map("kpi_key")
  label      String
  value      String
  unit       String?
  trendPct   Float?   @map("trend_pct")
  sortOrder  Int      @map("sort_order")
  chartTitle String?  @map("chart_title")
  chartData  Json?    @map("chart_data")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([periodId, tabKey, sortOrder])
}

model IfoodContent {
  id          String   @id
  periodId    String   @map("period_id")
  tabKey      String   @map("tab_key")
  contentHtml String   @map("content_html")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@unique([periodId, tabKey])
  @@index([periodId])
}

model IfoodHighlight {
  id        String   @id
  periodId  String   @map("period_id")
  icon      String?
  title     String
  body      String?
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([periodId, sortOrder])
}

model IfoodRawData {
  id         String   @id
  periodId   String   @map("period_id")
  filename   String
  rawJson    Json     @map("raw_json")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@index([periodId, uploadedAt])
}
