    {
      "parameters": {
        "jsCode": "const body = $('Webhook').item.json.body;\nreturn [{\n  json: {\n    messages: [\n      {\n        role: 'system',\n        content: 'Você é um editor de conteúdo jurídico especializado. Revise e melhore artigos conforme as instruções fornecidas, mantendo o estilo profissional e a precisão jurídica. Retorne APENAS o artigo revisado, sem comentários adicionais.'\n      },\n      {\n        role: 'user',\n        content: 'Instruções de edição: ' + body.edit_instructions + '\\n\\nArtigo original:\\n' + body.article\n      }\n    ],\n    model: body.model || 'gpt-4o',\n    temperature: 0.5,\n    max_tokens: 8192\n  }\n}];"
      },
      "id": "node-prep-edit",
      "name": "Preparar Edição",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 440]
