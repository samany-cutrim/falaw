        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "node-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "k1",
              "name": "GITHUB_TOKEN",
              "value": "SEU_TOKEN_GITHUB_AQUI",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-keys",
      "name": "Configurar Chaves",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $('Webhook').item.json.body.edit_instructions }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "node-if-edit",
      "name": "edicao",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://models.inference.ai.azure.com/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Configurar Chaves').item.json.GITHUB_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Webhook').item.json.body.model || 'gpt-4o', messages: $('Webhook').item.json.body.messages, temperature: $('Webhook').item.json.body.temperature || 0.7, max_tokens: 8192 }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "node-ia-direct",
      "name": "Chamar GitHub Models",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const r = $input.item.json;\nif (!r.choices) return [{ json: { text: '', error: true, errorMessage: r.error?.message || r.message || JSON.stringify(r) } }];\nreturn [{ json: { text: r.choices[0].message.content, error: false } }];"
      },
      "id": "node-extract-direct",
      "name": "Extrair Resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        160
      ]
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "id": "node-respond-direct",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1340,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').item.json.body;\nreturn [{ json: { messages: [{ role: 'system', content: 'Voce e um editor juridico. Revise o artigo conforme instrucoes. Retorne APENAS o artigo revisado.' }, { role: 'user', content: 'Instrucoes: ' + body.edit_instructions + '\\n\\nArtigo:\\n' + body.article }], model: body.model || 'gpt-4o', temperature: 0.5, max_tokens: 8192 } }];"
      },
      "id": "node-prep-edit",
      "name": "Preparar Edicao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        440
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://models.inference.ai.azure.com/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Configurar Chaves').item.json.GITHUB_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.model, messages: $json.messages, temperature: $json.temperature, max_tokens: $json.max_tokens }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "node-ia-edit",
      "name": "Chamar IA Edicao",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        440
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const r = $input.item.json;\nif (!r.choices) return [{ json: { text: '', error: true, edited: false, errorMessage: r.error?.message || r.message || JSON.stringify(r) } }];\nreturn [{ json: { text: r.choices[0].message.content, error: false, edited: true } }];"
      },
      "id": "node-extract-edit",
      "name": "Extrair Edicao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
