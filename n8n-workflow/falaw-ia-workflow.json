    {
      "parameters": {
        "jsCode": "const body = $('Webhook').item.json.body;\nconst area = body.area || 'direito empresarial';\nconst quantity = body.quantity || 5;\nreturn [{\n  json: {\n    messages: [\n      {\n        role: 'system',\n        content: 'Você é um especialista em marketing jurídico. Sugira temas relevantes e atuais para artigos de blog de um escritório de advocacia.'\n      },\n      {\n        role: 'user',\n        content: `Sugira ${quantity} temas para artigos sobre ${area}. Para cada tema forneça: título sugestivo, breve descrição (2 linhas) e público-alvo. Responda em JSON com a chave \"temas\" contendo um array de objetos { titulo, descricao, publico_alvo }.`\n      }\n    ],\n    model: body.model || 'gpt-4o',\n    temperature: body.temperature || 0.8,\n    max_tokens: 2048\n  }\n}];"
      },
      "id": "node-prep-topics",
      "name": "Preparar Sugestão de Temas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 160]
